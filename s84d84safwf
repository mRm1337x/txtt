    max-width: 620px;
    width: 100%;
    margin: 20px auto;
    position: relative;
    overflow: hidden;
    border-radius: 24px;
    padding: 28px 24px;
    background: radial-gradient(circle at top left, #ffffff4, #4c4e50 60%, #2f3334);
    border: 1px solid rgba(255, 217, 0, 0.45);
    box-shadow: 0 18px 40px rgba(0,0,0,.35);
    color: #fff;
}

.NEGERITOTO-card::before {
    content: "☾";
    position: absolute;
    top: 18px;
    right: 28px;
    font-size: 70px;
    color: rgba(255, 230, 120, .28);
    text-shadow: 0 0 25px rgb(255, 23, 15);
}

.NEGERITOTO-card::after {
    content: "✦ ✧ ✦ ✧ ✦ ✧";
    position: absolute;
    top: 25px;
    left: 22px;
    width: 90%;
    font-size: 18px;
    letter-spacing: 18px;
    color: rgba(255,255,255,.55);
    animation: starFloat 6s ease-in-out infinite alternate;
}

@keyframes starFloat {
    from { transform: translateY(0); opacity: .45; }
    to { transform: translateY(12px); opacity: .9; }
}

.hero-title {
    position: relative;
    z-index: 2;
    text-align: center;
    margin-bottom: 20px;
}

.hero-title h1 {
    font-size: 24px;
    line-height: 1.35;
    margin: 0;
    color: #fff;
    font-weight: 800;
}

.hero-title h1 span {
    color: #000;
}

.info-container,
.bonus-wrap {
    position: relative;
    z-index: 2;
    background: rgba(255,255,255,.08);
    border: 1px solid rgb(255, 23, 15);
    border-radius: 18px;
    overflow: hidden;
    backdrop-filter: blur(8px);
}

.info-head {
    padding: 12px 16px;
    background: rgb(255, 23, 15);
    border-bottom: 1px solid rgb(251, 255, 0);
}

.info-head h2 {
    margin: 0;
    font-size: 15px;
    text-align: center;
    color: #000;
    letter-spacing: .8px;
}

.info-row {
    padding: 12px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    border-bottom: 1px solid rgba(255,255,255,.08);
}

.info-row:last-child {
    border-bottom: none;
}

.info-label {
    display: flex;
    align-items: center;
    gap: 9px;
}

.info-dot,
.gold-icon {
    width: 7px;
    height: 7px;
    background: #000;
    border-radius: 50%;
    box-shadow: 0 0 12px #000;
}

.info-text {
    font-size: 14px;
    font-weight: 600;
    color: #f7f7f7;
}

.info-number {
    font-size: 13px;
    font-weight: 700;
    color: #111;
    background: linear-gradient(135deg, #ff0000, #4f0100);
    padding: 5px 12px;
    border-radius: 30px;
    white-space: nowrap;
}

.bonus-wrap {
    margin: 20px 0 22px;
    padding: 18px 16px;
    text-align: center;
}

.bonus-head {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    margin-bottom: 14px;
}

.bonus-head h3 {
    margin: 0;
    font-size: 15px;
    color: #000;
}

.bonus-list {
    display: grid;
    gap: 10px;
}

.bonus-item {
    padding: 11px 14px;
    border-radius: 14px;
    background: rgb(255, 23, 15);
    border-left: 3px solid #000;
    text-align: left;
}

.bonus-item p {
    margin: 0;
    font-size: 14px;
    font-weight: 650;
    color: #fff;
}

.highlight-gold {
    color: #000;
}

.cta-buttons-gold {
    position: relative;
    z-index: 2;
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
}

.btn-gold {
    display: inline-block;
    min-width: 125px;
    padding: 12px 28px;
    border-radius: 40px;
    font-size: 14px;
    font-weight: 800;
    text-align: center;
    text-decoration: none;
    transition: .25s ease;
}

.btn-login-gold {
    color: #000;
    border: 1px solid #000;
    background: transparent;
}

.btn-register-gold {
    color: #111;
    border: 1px solid #000;
    background: linear-gradient(135deg, #ff0000, #4f0100);
}

.btn-gold:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 18px rgba(255,217,0,.25);
}

@media (max-width: 480px) {
    .NEGERITOTO-card {
        padding: 24px 16px;
        border-radius: 20px;
    }

    .hero-title h1 {
        font-size: 20px;
    }

    .info-row {
        align-items: flex-start;
        flex-direction: column;
    }

    .info-number {
        align-self: flex-start;
    }
}
</style>
