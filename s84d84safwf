      (function () {
        const wrap = document.getElementById("mdRtpCalendar");
        const clock = document.getElementById("mdRtpClock");
        if (wrap && clock) {
          const dayNames = ["MIN", "SEN", "SEL", "RAB", "KAM", "JUM", "SAB"];
          const monthNames = ["Jan", "Feb", "Mar", "Apr", "Mei", "Jun", "Jul", "Agu", "Sep", "Okt", "Nov", "Des"];
          function seededRandom(seed) { const x = Math.sin(seed) * 10000; return x - Math.floor(x); }
          function getRtpValue(date, index) {
            const now = new Date();
            const updateBlock = Math.floor(now.getMinutes() / 15);
            const seed = date.getFullYear() * 10000 + (date.getMonth() + 1) * 100 + date.getDate() + index * 77 + updateBlock * 33;
            return (86 + seededRandom(seed) * 12).toFixed(2);
          }
          function getStatus(rtp) {
            const value = parseFloat(rtp);
            if (value >= 95) return "HOT";
            if (value >= 91) return "STABIL";
            return "NORMAL";
          }
          function renderCalendar() {
            const space = new Date();
            wrap.innerHTML = "";
            for (let i = 0; i < 7; i++) {
              const date = new Date();
              date.setDate(space.getDate() + i);
              const rtp = getRtpValue(date, i);
              const card = document.createElement("div");
              card.className = "md-rtp-card" + (i === 0 ? " is-active" : "");
              card.innerHTML = `<div class="md-rtp-day">${i === 0 ? "HARI INI" : dayNames[date.getDay()]}</div><div class="md-rtp-date">${date.getDate()} ${monthNames[date.getMonth()]}</div><div class="md-rtp-percent">${rtp}%</div><div class="md-rtp-status">${getStatus(rtp)}</div>`;
              wrap.appendChild(card);
            }
          }
          function updateClock() {
            const now = new Date();
            const jam = String(now.getHours()).padStart(2, "0");
            const menit = String(now.getMinutes()).padStart(2, "0");
            const detik = String(now.getSeconds()).padStart(2, "0");
            clock.textContent = `LIVE ${jam}:${menit}:${detik} | Informasi NEGERITOTO`;
          }
          renderCalendar();
          updateClock();
          setInterval(updateClock, 1000);
          setInterval(renderCalendar, 60000);
        }

        document.querySelectorAll(".md-faq-question").forEach(function (button) {
          button.addEventListener("click", function () {
            const item = button.closest(".md-faq-item");
            const isOpen = item.classList.contains("is-open");
            document.querySelectorAll(".md-faq-item").forEach(function (faq) {
              faq.classList.remove("is-open");
              const btn = faq.querySelector(".md-faq-question");
              const icon = faq.querySelector(".md-faq-icon");
              if (btn) btn.setAttribute("aria-expanded", "false");
              if (icon) icon.textContent = "+";
            });
            if (!isOpen) {
              item.classList.add("is-open");
              button.setAttribute("aria-expanded", "true");
              const icon = button.querySelector(".md-faq-icon");
              if (icon) icon.textContent = "−";
            }
          });
        });
      })();
