<script>
(() => {
  const leafCanvas = document.getElementById("leaf-canvas");
  const leafCtx = leafCanvas.getContext("2d");

  const gust = document.getElementById("wind-gust");

  const windCanvas = document.getElementById("wind-canvas");
  const windCtx = windCanvas.getContext("2d");

  function random(min, max){
    return Math.random() * (max - min) + min;
  }

  function resizeCanvas(){
    leafCanvas.width = window.innerWidth;
    leafCanvas.height = window.innerHeight;

    windCanvas.width = window.innerWidth;
    windCanvas.height = window.innerHeight;
  }

  resizeCanvas();
  window.addEventListener("resize", resizeCanvas);

  // Autumnal palette — adjust to taste
  const leafColors = [
    "#d97a3a", // burnt orange
    "#e0a236", // amber
    "#c14b2a", // rust
    "#8fae3c", // olive green
    "#b08537", // brown gold
    "#e3c14d"  // mustard
  ];

  const leaves = [];
  const leafCount = Math.min(90, Math.floor(window.innerWidth / 14));

  for(let i = 0; i < leafCount; i++){
    leaves.push({
      x: random(0, leafCanvas.width),
      y: random(-leafCanvas.height, leafCanvas.height),
      size: random(8, 18),
      speedY: random(0.6, 1.6),
      drift: random(0.5, 1.6),
      swayAmp: random(20, 55),
      swayFreq: random(0.005, 0.015),
      phase: random(0, Math.PI * 2),
      rot: random(0, Math.PI * 2),
      rotSpeed: random(-0.025, 0.025),
      color: leafColors[Math.floor(random(0, leafColors.length))],
      alpha: random(0.65, 0.95)
    });
  }

  // Global wind that ebbs and flows
  let windStrength = 1;
  let windTarget = 1;

  function drawLeafShape(ctx, size){
    // Simple leaf silhouette: a pointed oval with a center vein
    ctx.beginPath();
    ctx.moveTo(0, -size);
    ctx.bezierCurveTo(size * 0.7, -size * 0.6, size * 0.7, size * 0.6, 0, size);
    ctx.bezierCurveTo(-size * 0.7, size * 0.6, -size * 0.7, -size * 0.6, 0, -size);
    ctx.closePath();
    ctx.fill();

    // vein
    ctx.beginPath();
    ctx.strokeStyle = "rgba(0,0,0,0.25)";
    ctx.lineWidth = Math.max(0.6, size * 0.06);
    ctx.moveTo(0, -size);
    ctx.lineTo(0, size);
    ctx.stroke();
  }

  let t = 0;

  function drawLeaves(){
    leafCtx.clearRect(0, 0, leafCanvas.width, leafCanvas.height);
    t += 1;

    // Ease wind strength toward target
    windStrength += (windTarget - windStrength) * 0.02;

    for(let l of leaves){
      const sway = Math.sin(t * l.swayFreq + l.phase) * l.swayAmp;
      const drawX = l.x + sway;

      leafCtx.save();
      leafCtx.translate(drawX, l.y);
      leafCtx.rotate(l.rot);
      leafCtx.globalAlpha = l.alpha;
      leafCtx.fillStyle = l.color;
      drawLeafShape(leafCtx, l.size);
      leafCtx.restore();

      l.y += l.speedY * windStrength;
      l.x += l.drift * windStrength;
      l.rot += l.rotSpeed * windStrength;

      if(l.y - l.size > leafCanvas.height){
        l.y = -l.size - random(0, 60);
        l.x = random(-50, leafCanvas.width);
      }
      if(l.x - l.size > leafCanvas.width){
        l.x = -l.size;
        l.y = random(-leafCanvas.height * 0.4, leafCanvas.height);
      }
    }

    requestAnimationFrame(drawLeaves);
  }

  drawLeaves();

  // Wind streaks — faint horizontal curves that sweep across the screen
  function drawWindStreak(){
    const streakCount = Math.floor(random(4, 9));
    const startY = random(windCanvas.height * 0.15, windCanvas.height * 0.85);

    for(let i = 0; i < streakCount; i++){
      const y = startY + random(-90, 90);
      const startX = random(-100, windCanvas.width * 0.2);
      const endX = startX + random(windCanvas.width * 0.7, windCanvas.width * 1.1);
      const cpY = y + random(-25, 25);

      windCtx.beginPath();
      windCtx.moveTo(startX, y);
      windCtx.quadraticCurveTo((startX + endX) / 2, cpY, endX, y);

      windCtx.strokeStyle = `rgba(255,255,255,${random(0.18, 0.38)})`;
      windCtx.lineWidth = random(0.8, 2);
      windCtx.shadowBlur = 12;
      windCtx.shadowColor = "rgba(255,255,255,0.6)";
      windCtx.stroke();
    }

    // Subtle gust flash + boost wind
    windTarget = random(2.2, 3.4);

    gust.style.transition = "none";
    gust.style.opacity = random(0.18, 0.32);

    setTimeout(() => {
      gust.style.transition = "opacity 0.8s ease-out";
      gust.style.opacity = 0;
    }, 200);

    // Fade out streaks gradually
    let fade = 1;
    const fadeInterval = setInterval(() => {
      fade -= 0.08;
      windCtx.clearRect(0, 0, windCanvas.width, windCanvas.height);
      if(fade <= 0){
        clearInterval(fadeInterval);
        windTarget = random(0.8, 1.3);
      }
    }, 60);
  }

  function dramaticWind(){
    drawWindStreak();

    if(Math.random() > 0.5){
      setTimeout(drawWindStreak, random(400, 900));
    }

    setTimeout(dramaticWind, random(6500, 13000));
  }

  setTimeout(dramaticWind, 3500);
})();
</script>
