<script>
(function(){
  const list      = document.getElementById("rtpGamesList");
  const clock     = document.getElementById("rtpClockbrand");
  const heroPct   = document.getElementById("rtpHeroPct");
  const heroBdg   = document.getElementById("rtpHeroBadge");
  const heroDt    = document.getElementById("rtpHeroDate");
  const heroDelta = document.getElementById("rtpHeroDelta");
  const heroSpark = document.getElementById("rtpHeroSpark");
  if(!list || !clock) return;

  const monthNames = ["Januari","Februari","Maret","April","Mei","Juni","Juli","Agustus","September","Oktober","November","Desember"];
  const games = [
    {name:"Gates of Olympus",   prov:"Pragmatic", leaf:"🍂"},
    {name:"Starlight Princess", prov:"Pragmatic", leaf:"🍂"},
    {name:"Sweet Bonanza",      prov:"Pragmatic", leaf:"🍂"},
    {name:"Mahjong Ways 2",     prov:"PG Soft",   leaf:"🌿"},
    {name:"Lucky Neko",         prov:"PG Soft",   leaf:"🌿"},
    {name:"Treasures of Aztec", prov:"PG Soft",   leaf:"🌿"},
    {name:"Hot Hot Fruit",      prov:"Habanero",  leaf:"🍁"},
    {name:"Koi Gate",           prov:"Habanero",  leaf:"🍁"}
  ];
  const HISTORY = 8;

  function seededRandom(seed){
    const x = Math.sin(seed) * 10000;
    return x - Math.floor(x);
  }
  function rtpFor(i, block){
    const seed = i * 137 + block * 31 + 7;
    return 85 + seededRandom(seed) * 13;
  }
  function moodOf(v){
    if(v >= 94) return "Panas hari ini";
    if(v >= 90) return "Stabil";
    return "Tenang";
  }
  function deltaPart(delta){
    if(delta > 0.05)  return {cls:"up",   txt:"↗ +" + delta.toFixed(1)};
    if(delta < -0.05) return {cls:"down", txt:"↘ " + delta.toFixed(1)};
    return {cls:"flat", txt:"— stabil"};
  }
  function smoothPath(vals, w, h, pad){
    const min = Math.min.apply(null, vals);
    const max = Math.max.apply(null, vals);
    const range = max - min || 1;
    const stepX = (w - pad*2) / (vals.length - 1);
    const pts = vals.map((v, i) => [
      pad + i*stepX,
      pad + (h - pad*2) * (1 - (v - min) / range)
    ]);
    let d = "M" + pts[0][0].toFixed(1) + " " + pts[0][1].toFixed(1);
    for(let i=1; i<pts.length; i++){
      const [x0,y0] = pts[i-1], [x1,y1] = pts[i];
      const cx = (x0 + x1) / 2;
      d += " Q" + cx.toFixed(1) + " " + y0.toFixed(1) + " " + cx.toFixed(1) + " " + ((y0+y1)/2).toFixed(1);
      d += " T" + x1.toFixed(1) + " " + y1.toFixed(1);
    }
    return {d, last: pts[pts.length-1]};
  }
  function rowSpark(vals){
    const W = 56, H = 20, PAD = 2;
    const {d, last} = smoothPath(vals, W, H, PAD);
    return `<svg class="rtp-spark" viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" aria-hidden="true">`
         + `<path d="${d}"/>`
         + `<circle cx="${last[0].toFixed(1)}" cy="${last[1].toFixed(1)}" r="1.7"/>`
         + `</svg>`;
  }
  function heroSparkRender(vals){
    const W = 180, H = 36, PAD = 3;
    const {d, last} = smoothPath(vals, W, H, PAD);
    const areaD = d + ` L${(W-PAD).toFixed(1)} ${(H-PAD).toFixed(1)} L${PAD.toFixed(1)} ${(H-PAD).toFixed(1)} Z`;
    heroSpark.innerHTML =
      `<path class="area" d="${areaD}"/>` +
      `<path class="line" d="${d}"/>` +
      `<circle cx="${last[0].toFixed(1)}" cy="${last[1].toFixed(1)}" r="2.4"/>`;
  }

  function render(){
    const now = new Date();
    const block = Math.floor(now.getTime() / (15*60*1000));

    // average per past block, for the hero sparkline
    const avgHistory = [];
    for(let b = block - HISTORY + 1; b <= block; b++){
      let s = 0;
      for(let i=0; i<games.length; i++) s += rtpFor(i, b);
      avgHistory.push(s / games.length);
    }

    const rowsHtml = games.map((g, i) => {
      const history = [];
      for(let b = block - HISTORY + 1; b <= block; b++) history.push(rtpFor(i, b));
      const v    = history[history.length - 1];
      const prev = history[history.length - 2];
      const d    = deltaPart(v - prev);
      return `
        <div class="rtp-game-row">
          <span class="rtp-game-leaf">${g.leaf}</span>
          <span class="rtp-game-name">
            <b>${g.name}</b>
            <small>${g.prov}</small>
          </span>
          ${rowSpark(history)}
          <span class="rtp-game-figure">
            <span class="rtp-game-pct">${v.toFixed(1)}%</span>
            <span class="rtp-delta ${d.cls}">${d.txt}</span>
          </span>
        </div>`;
    }).join("");
    // duplicate rows for seamless vertical scroll loop (translateY -50% lands on a copy)
    list.innerHTML = rowsHtml + rowsHtml;

    const avg     = avgHistory[avgHistory.length - 1];
    const avgPrev = avgHistory[avgHistory.length - 2];
    const dHero   = deltaPart(avg - avgPrev);
    heroPct.textContent   = avg.toFixed(1) + "%";
    heroBdg.textContent   = moodOf(avg);
    heroDelta.textContent = dHero.txt + " sejak jam lalu";
    heroDelta.className   = "rtp-pick-delta " + dHero.cls;
    heroDt.textContent    = now.getDate() + " " + monthNames[now.getMonth()] + " " + now.getFullYear();
    heroSparkRender(avgHistory);
  }

  function updateClock(){
    const now = new Date();
    const pad = n => String(n).padStart(2,"0");
    clock.textContent = pad(now.getHours()) + ":" + pad(now.getMinutes());
  }

  render();
  updateClock();
  setInterval(updateClock, 30000);
  setInterval(render, 60000);
})();
</script>
