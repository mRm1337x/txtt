    /* TEKS SLOWLY FLYING KILAT CEPAT & TEBAL */
    .fast-flash-text {
      font-weight: 900;
      font-size: 14px;
      letter-spacing: 1.5px;
      display: inline-block;
      background: linear-gradient(
