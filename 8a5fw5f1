  <style amp-custom>
    :root {
      --bg: #030001;
      --panel: #0a0103;
      --panel2: #180206;
      --rose: #ffe600;
      --rose-light: #ffd633;
      --rose-glow: #ffff00;
      --rose-dark: #807700;
      --white: #ffffff;
      --text: #fff0f3;
