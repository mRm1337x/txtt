      letter-spacing: .5px;
      padding: 14px 10px;
      margin-top: 8px;
      position: relative;
      z-index: 2;
      background: linear-gradient(180deg, #1f1e02, #030001);
      border-top: 1px solid var(--rose);
      border-bottom: 1px solid rgba(255, 234, 0, 0.3);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05), 0 0 15px rgba(255, 234, 0, 0.3);
