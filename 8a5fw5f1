        0 0 15px rgba(255, 217, 0, 0.5);
      transition: transform .18s ease, box-shadow .18s ease, filter .18s ease;
    }

    .btn::before {
      content: "";
      position: absolute;
      top: 5px;
      left: 7px;
      right: 7px;
      height: 8px;
      border-radius: 5px;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.2),
        rgba(255, 219, 102, 0.9),
        rgba(255, 255, 255, 0.2),
        transparent
      );
      filter: blur(.2px);
      opacity: .8;
    }

    /* Scanner Kilat Cepat (Tombol) */
    .btn::after {
      content: "";
      position: absolute;
      top: -20%;
      left: -80%;
      width: 40%;
      height: 140%;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.8),
