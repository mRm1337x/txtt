    }

    * {
      box-sizing: border-box;
    }

    html, body {
      margin: 0;
      min-height: 100%;
    }

    body {
      font-family: 'Inter', sans-serif;
      color: var(--text);
      background:
        radial-gradient(circle at 50% 0%, rgba(246, 255, 0, 0.25), transparent 40%),
        repeating-linear-gradient(
          90deg,
          rgba(255, 51, 102, 0.02) 0px,
          rgba(255, 51, 102, 0.02) 1px,
          transparent 1px,
          transparent 35px
        ),
        linear-gradient(180deg, #040500, #000);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      padding: 16px;
    }

    /* ========================= ROBOT MAIN SHELL ========================= */
    .shell {
      max-width: 520px;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
      position: relative;
    }

    /* Garis Teknologi Kiri Kanan (Merah Mawar Glowing) */
    .shell::before, .shell::after {
      content: "";
      position: fixed;
      top: 0;
      bottom: 0;
      width: 2px;
      background: linear-gradient(
        transparent,
        var(--rose-light),
        var(--rose),
        transparent
      );
      box-shadow: 0 0 20px var(--rose-glow), 0 0 10px var(--rose);
      pointer-events: none;
    }

    .shell::before {
      left: calc(50% - 285px);
    }

    .shell::after {
      right: calc(50% - 285px);
    }

    /* ========================= HEADER / LOGO ========================= */
    .header {
      width: 100%;
      display: flex;
      justify-content: center;
      position: relative;
      padding: 16px 18px;
      background: linear-gradient(145deg, #2b2702, #080800 45%, #151a01);
      border: 2px solid var(--rose);
      clip-path: polygon(
        18px 0,
        calc(100% - 18px) 0,
        100% 18px,
        100% calc(100% - 18px),
        calc(100% - 18px) 100%,
        18px 100%,
        0 calc(100% - 18px),
        0 18px
      );
      box-shadow:
        0 12px 25px rgba(0, 0, 0, 0.9),
        inset 0 1px 0 rgba(255, 255, 255, 0.3),
        inset 0 -5px 10px rgba(0, 0, 0, 0.95),
        0 0 25px rgba(255, 234, 0, 0.6);
    }

    /* Baut Robot Merah Mawar */
    .header::before, .header::after {
      content: "";
      position: absolute;
      width: 10px;
      height: 10px;
      top: 50%;
      transform: translateY(-50%);
      border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, #fff, var(--rose-light) 30%, var(--rose-dark) 70%, #000);
      border: 1px solid #000;
      box-shadow: 0 0 10px var(--rose-glow);
    }

    .header::before { left: 12px; }
    .header::after { right: 12px; }

    .logo {
      border-radius: 8px;
      max-width: 100%;
      filter: drop-shadow(0 5px 6px rgba(8, 8, 8, 0.9)) drop-shadow(0 0 12px var(--rose-glow));
    }

    /* ========================= MARQUEE ROBOT DISPLAY ========================= */
    .marquee-wrapper {
      width: 100%;
      position: relative;
      overflow: hidden;
      padding: 11px 0;
      background: linear-gradient(180deg, #1f1e02, #040500);
      border-top: 2px solid var(--rose);
      border-bottom: 2px solid var(--rose);
      box-shadow:
        inset 0 5px 12px rgba(255, 255, 255, 0.05),
        inset 0 -5px 12px rgba(0, 0, 0, 0.9),
        0 0 20px rgba(255, 217, 0, 0.5);
    }

    .marquee-wrapper::before {
      content: "";
      position: absolute;
      top: 2px;
      left: 8px;
      font-size: 6px;
      letter-spacing: 2px;
      color: var(--rose-light);
    }

    .marquee-text {
      display: inline-block;
      white-space: nowrap;
      color: #fff;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 1px;
      padding-left: 100%;
      text-shadow: 0 0 8px var(--rose), 0 0 15px var(--rose-glow);
      animation: marquee 9s linear infinite;
    }

    @keyframes marquee {
      0% { transform: translateX(0); }
      100% { transform: translateX(-100%); }
    }

    /* ========================= ROBOT MECHA CARD ========================= */
    .card {
      position: relative;
      width: 100%;
      padding: 22px;
      background:
        linear-gradient(135deg, rgba(255, 248, 51, 0.15), transparent 15%),
        repeating-linear-gradient(
          90deg,
          rgba(255, 208, 0, 0.03) 0,
          rgba(255, 208, 0, 0.03) 1px,
          transparent 1px,
          transparent 8px
        ),
        linear-gradient(145deg, #2b2702 0%, #080800 30%, #141501 70%, #020200 100%);
      border: 2px solid var(--rose);
      clip-path: polygon(
        24px 0,
        calc(100% - 24px) 0,
        100% 24px,
        100% calc(100% - 24px),
        calc(100% - 24px) 100%,
        24px 100%,
        0 calc(100% - 24px),
        0 24px
      );
      box-shadow:
        0 25px 45px rgba(0, 0, 0, 0.95),
        0 0 30px rgba(255, 217, 0, 0.5),
        inset 0 1px 0 rgba(255, 255, 255, 0.25),
        inset 0 -10px 25px rgba(0, 0, 0, 0.95);
      overflow: hidden;
      transition: .35s ease;
    }

    /* Garis Cahaya Scanner Kilat Cepat (Card) */
    .card::before {
      content: "";
      position: absolute;
      top: 0;
      left: -130%;
      width: 70%;
      height: 100%;
      z-index: 0;
      background: linear-gradient(
        110deg,
        transparent,
        rgba(255, 238, 0, 0.05),
        rgba(242, 255, 102, 0.4),
        rgba(255, 255, 255, 0.7),
        rgba(238, 255, 0, 0.1),
        transparent
      );
      transform: skewX(-18deg);
      animation: robotScanner 2.2s linear infinite;
    }

    @keyframes robotScanner {
      0% { left: -130%; }
      100% { left: 160%; }
    }

    .card::after {
      content: "";
      position: absolute;
      inset: 8px;
      pointer-events: none;
      border: 1px solid rgba(255, 214, 51, 0.4);
      clip-path: polygon(
        18px 0,
        calc(100% - 18px) 0,
        100% 18px,
        100% calc(100% - 18px),
        calc(100% - 18px) 100%,
        18px 100%,
        0 calc(100% - 18px),
        0 18px
