        #ffe600 0%,
        #ffd966 25%,
        #ffffff 50%,
        #ffd966 75%,
        #ffe600 100%
      );
      background-size: 200% auto;
      color: transparent;
      -webkit-background-clip: text;
      background-clip: text;
      text-shadow: 0 0 12px rgba(255, 200, 0, 0.8), 0 0 20px rgba(255, 217, 0, 0.5);
      animation: fastFlash 0.8s linear infinite; /* Kilat Cepat 0.8 Detik */
    }

    @keyframes fastFlash {
      0% {
        background-position: 0% center;
        filter: brightness(1) drop-shadow(0 0 5px #ffe600);
      }
      50% {
        filter: brightness(1.6) drop-shadow(0 0 15px #ffffff);
      }
      100% {
