    <style amp-custom>
        /* ============ VARIABLES ============ */
        :root {
            --bg: #120E09;
            --bg-2: #1C1610;
            --bg-3: #0A0704;

            --red: #C4A484;
            --red-bright: #E8D5B7;
            --red-soft: #F5E6D3;
            --red-deep: #8B6F4E;

            --fire: #1A140C;

            --gold: #C4A484;
            --gold-bright: #E8D5B7;
            --gold-soft: #edc603;
            --gold-deep: #8B6F4E;

            --silver: #E8E8E8;
            --silver-dark: #B0B0B0;
        }

        * {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent
        }

        html,
        body {
            margin: 0;
            padding: 0
        }

        /* ============ BACKGROUND ============ */
        body {
            min-height: 100vh;
            font-family: 'Press Start 2P', cursive;
            color: var(--gold-soft);
            position: relative;
            overflow-x: hidden;
            background:
                radial-gradient(ellipse at 50% -10%, rgba(196, 164, 132, 0.35), transparent 55%),
                radial-gradient(ellipse at 50% 110%, rgba(139, 111, 78, 0.35), transparent 55%),
                linear-gradient(180deg, var(--bg) 0%, var(--bg-2) 50%, #000000 100%);
        }

        body::before {
            content: "";
            position: fixed;
            inset: 0;
            background:
                repeating-linear-gradient(to bottom,
                    transparent 0 2px,
                    rgba(255, 255, 255, .03) 2px 3px,
                    transparent 3px 5px),
                radial-gradient(ellipse at center, transparent 40%, rgba(0, 0, 0, 0.75) 100%);
            pointer-events: none;
            z-index: 1;
        }

        .ticker {
            position: relative;
            z-index: 10;
            max-width: 460px;
            margin: 24px auto 0;
            overflow: hidden;

            background:
                linear-gradient(90deg,
                    rgb(0, 0, 0) 0%,
                    rgb(0 0 0 / 95%) 50%,
                    rgb(0, 0, 0) 100%);

            border: 1px solid var(--gold);
            border-radius: 8px 8px 0 0;
            border-bottom: none;

            box-shadow:
                0 0 12px rgba(196, 164, 132, 0.45),
                inset 0 0 8px rgba(0, 0, 0, .6);

            padding: 7px 0;

            font-family: 'Press Start 2P', cursive;
            font-size: 9px;
            letter-spacing: 1px;

            color: var(--gold-soft);

            mask-image:
                linear-gradient(90deg,
                    transparent 0,
                    #000 6%,
                    #000 94%,
                    transparent 100%);

            -webkit-mask-image:
                linear-gradient(90deg,
                    transparent 0,
                    #000 6%,
                    #000 94%,
                    transparent 100%);
        }

        .ticker-inner {
            display: inline-block;
            white-space: nowrap;
            animation: tickerScroll 24s linear infinite;
            will-change: transform;
            padding-left: 100%;
        }

        .ticker-inner span {
            padding: 0 22px;
        }

        .ticker-inner .hl {
            color: var(--gold-bright);
            text-shadow:
                0 0 6px var(--gold);
        }

        .ticker-inner .sep {
            color: var(--red-bright);
            padding: 0 6px;
        }

        @keyframes tickerScroll {
            0% {
                transform: translate3d(0, 0, 0);
            }

            100% {
                transform: translate3d(-100%, 0, 0);
            }
        }

        /* ============ LIVE PLAYER STRIP ============ */
        .live-strip {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            margin: 0 auto 12px;
            padding: 5px 14px;
            font-family: 'Press Start 2P', cursive;
            font-size: 8px;
            letter-spacing: 1.2px;
            color: var(--silver);
            background: linear-gradient(180deg, rgba(60, 45, 30, .95), rgba(30, 22, 15, .95));
            border: 1px solid var(--silver-dark);
            border-radius: 30px;
            box-shadow:
                0 0 10px rgba(196, 164, 132, .45),
                inset 0 0 6px rgba(232, 232, 232, .12);
        }

        .live-strip .live-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--gold-bright);
            box-shadow: 0 0 8px var(--gold), 0 0 12px rgba(196, 164, 132, .7);
            animation: dotBlink 1.4s ease-in-out infinite;
        }

        .live-strip strong {
            color: #FFF;
            font-size: 10px;
            text-shadow: 0 0 6px var(--gold);
            letter-spacing: .5px;
        }

        /* ============ CORNER ORNAMENTS (4 pojok arcade) ============ */
        .corner {
            position: absolute;
            width: 16px;
            height: 16px;
            pointer-events: none;
            z-index: 3;
        }

        .corner.c-tl {
            top: -2px;
            left: -2px;
            border-top: 3px solid var(--gold-bright);
            border-left: 3px solid var(--gold-bright);
            border-top-left-radius: 14px;
            box-shadow: -1px -1px 10px rgba(232, 213, 183, .65);
        }

        .corner.c-tr {
            top: -2px;
            right: -2px;
            border-top: 3px solid var(--gold-bright);
            border-right: 3px solid var(--gold-bright);
            border-top-right-radius: 14px;
            box-shadow: 1px -1px 10px rgba(232, 213, 183, .65);
        }

        .corner.c-bl {
            bottom: -2px;
            left: -2px;
            border-bottom: 3px solid var(--gold-bright);
            border-left: 3px solid var(--gold-bright);
            border-bottom-left-radius: 14px;
            box-shadow: -1px 1px 10px rgba(232, 213, 183, .65);
        }

        .corner.c-br {
            bottom: -2px;
            right: -2px;
            border-bottom: 3px solid var(--gold-bright);
            border-right: 3px solid var(--gold-bright);
            border-bottom-right-radius: 14px;
            box-shadow: 1px 1px 10px rgba(232, 213, 183, .65);
        }

        /* ============ ARCADE FRAME ============ */
        .arcade-frame {
            position: relative;
            z-index: 2;

            max-width: 460px;
            margin: 0 auto 24px;

            background:
                radial-gradient(circle at top,
                    rgba(196, 164, 132, 0.12),
                    transparent 45%),
                linear-gradient(180deg,
                    rgb(0 0 0 / 96%),
                    rgba(18, 14, 9, 0.96));

            border: 3px solid var(--gold);
            border-radius: 14px;

            box-shadow:
                0 0 18px rgba(196, 164, 132, 0.5),
                0 0 40px rgba(139, 111, 78, 0.28),
                inset 0 0 25px rgba(0, 0, 0, .85),
                inset 0 0 0 1px rgba(196, 164, 132, 0.25);

            /* Anti-jank: paksa GPU layer untuk thunderShake */
            will-change: transform;
            transform: translate3d(0, 0, 0);
            contain: layout paint;
        }

        /* ============ SCREEN ============ */
        .screen {
            padding: 14px 18px 18px;
            text-align: center;
            position: relative;
        }

        /* ============ TRUST BADGES (top row) ============ */
        .badges {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
            margin: 0 0 14px;
        }

        .badge {
            font-family: 'Press Start 2P', cursive;
            font-size: 7px;

            padding: 5px 8px;
            border-radius: 4px;

            letter-spacing: 1px;
            white-space: nowrap;

            border: 1px solid var(--gold-deep);

            background:
                linear-gradient(135deg,
                    #1A140C,
                    #000000);

            color: #FFFFFF;

            box-shadow:
                0 0 6px rgba(196, 164, 132, 0.4),
                inset 0 0 8px rgba(232, 232, 232, 0.08);
        }

        .badge.gold {
            background:
                linear-gradient(135deg,
                    var(--gold-bright),
                    var(--gold-deep));

            color: #000000;
            border-color: var(--gold-bright);

            text-shadow:
                0 1px 0 rgba(255, 255, 255, .3);

            box-shadow:
                0 0 8px rgba(196, 164, 132, .45),
                inset 0 0 8px rgba(255, 255, 255, .18);
        }

        .badge .dot {
            display: inline-block;

            width: 7px;
            height: 7px;

            border-radius: 50%;

            background: var(--gold-bright);

            box-shadow:
                0 0 6px var(--gold),
                0 0 12px rgba(196, 164, 132, 0.65);

            vertical-align: middle;
            margin-right: 5px;

            animation: dotBlink 1.6s ease-in-out infinite;
        }

        @keyframes dotBlink {

            0%,
            100% {
                opacity: 1;
                transform: scale(1);
            }

            50% {
                opacity: .4;
                transform: scale(.85);
            }
        }

        /* ============ LOGO (Chrome + Gold) ============ */
        .logo {
            margin: 6px 0 16px;
            font-size: 36px;
            font-weight: bold;
            letter-spacing: 3px;
            text-transform: uppercase;
            line-height: 1;
            position: relative;
            display: inline-block;
            background: linear-gradient(180deg,
                    #FFFFFF 0%,
                    #edc603 20%,
                    #C4A484 50%,
                    #E8D5B7 75%,
                    #A89070 100%);
            background-size: 100% 250%;
            background-position: 0% 0%;
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            color: transparent;
            -webkit-text-stroke: 1.5px var(--gold);
            filter:
                drop-shadow(0 0 8px rgba(196, 164, 132, .85)) drop-shadow(0 0 16px rgba(139, 111, 78, 0.5)) drop-shadow(0 2px 2px rgba(0, 0, 0, .95));
            animation: logoShimmer 3.4s ease-in-out infinite;
        }

        /* "77" style adapted to silver-brown */
        .logo span {
            background: linear-gradient(180deg,
                    #F5F5F5 0%,
                    #E8E8E8 30%,
                    var(--silver) 55%,
                    #A0A0A0 80%,
                    var(--silver) 100%);
            background-size: 100% 250%;
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            color: transparent;
            -webkit-text-stroke: 1.5px #FFF;
            filter: drop-shadow(0 0 8px rgba(196, 164, 132, 0.4)) drop-shadow(0 2px 2px rgba(0, 0, 0, .95));
            animation: logoShimmer 3.4s ease-in-out infinite .4s;
            margin-left: 6px;
        }

        @keyframes logoShimmer {

            0%,
            100% {
                background-position: 0% 0%
            }

            50% {
                background-position: 0% 100%
            }
        }

        /* ============ HERO IMAGE ============ */
        .hero {
            position: relative;
            margin: 0 0 6px;
        }

        .hero-media {
            position: relative;
            border-radius: 10px;
            overflow: hidden;
            box-shadow:
                0 0 0 2px var(--gold),
                0 0 22px rgba(196, 164, 132, 0.3),
                0 0 50px rgba(139, 111, 78, 0.2);
        }

        .hero-media amp-img {
            display: block
        }

        /* ============ BOOT OVERLAY ============ */
        .boot-overlay {
            position: absolute;
            inset: 0;

            background:
                radial-gradient(circle at center,
                    rgba(196, 164, 132, 0.2),
                    transparent 55%),
                linear-gradient(180deg,
                    #3D2E1A 0%,
                    #2A2014 55%,
                    #0A0704 100%);

            z-index: 6;

            display: flex;
            align-items: center;
            justify-content: center;

            animation: bootFadeOut .6s ease-out 2.4s forwards;

            pointer-events: none;

            box-shadow:
                inset 0 0 60px rgba(0, 0, 0, .7);
        }

        .boot-logo {
            font-family: 'Press Start 2P', cursive;
            font-size: 26px;

            color: var(--gold);

            text-shadow:
                0 0 10px var(--gold),
                0 0 22px var(--red-bright),
                0 0 38px rgba(139, 111, 78, 0.8);

            opacity: 0;
            transform: translateY(-150px);

            animation:
                logoDrop 1.2s cubic-bezier(.25, 1, .5, 1) forwards,
                glitchEffect .25s steps(2) 1.2s 6;

            will-change: transform;
        }

        .boot-logo span {
            font-size: 11px;
            vertical-align: top;
            margin-left: 3px;

            color: var(--red-soft);

            text-shadow:
                0 0 8px rgba(139, 111, 78, 0.8);
        }

        @keyframes logoDrop {
            0% {
                opacity: 1;
                transform: translateY(-150px);
            }

            60% {
                transform: translateY(8px);
            }

            80% {
                transform: translateY(-3px);
            }

            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes glitchEffect {

            0%,
            100% {
                text-shadow:
                    2px 0 var(--red-bright),
                    -2px 0 #A89070,
                    0 0 10px var(--gold);

                transform: translate(0);
            }

            25% {
                text-shadow:
                    -2px 0 var(--red-bright),
                    2px 0 #C4A484,
                    0 0 14px rgba(196, 164, 132, 0.8);

                transform: translate(1px, -1px);
            }

            50% {
                text-shadow:
                    2px 0 var(--red-bright),
                    -2px 0 #C4A484,
                    0 0 18px rgba(196, 164, 132, 0.8);

                transform: translate(-1px, 1px);
            }
        }

        @keyframes bootFadeOut {
            to {
                opacity: 0;
                visibility: hidden;
            }
        }

        /* ============ MENU ============ */
        .menu {
            margin-top: 18px;
            display: block
        }

        .menu a {
            display: block;
            position: relative;
            margin: 12px 0;
            padding: 18px 14px;
            font-size: 13px;
            font-weight: bold;
            letter-spacing: 3px;
            text-decoration: none;
            text-transform: uppercase;
            text-align: center;
            background: linear-gradient(180deg, rgba(50, 38, 25, 0.95), rgba(0, 0, 0, 0.95));
            border: 2px solid var(--gold);
            border-radius: 6px;
            overflow: hidden;
            transition: transform .15s ease;
            animation: menuBreath 2.6s ease-in-out infinite;
        }

        .menu a:nth-child(2) {
            animation-delay: -.85s
        }

        .menu a:nth-child(3) {
            animation-delay: -1.7s
        }

        @keyframes menuBreath {

            0%,
            100% {
                border-color: var(--gold-deep);
                color: var(--gold-soft);
                box-shadow:
                    0 0 10px rgba(196, 164, 132, 0.35),
                    inset 0 0 14px rgba(196, 164, 132, .08);
            }

            50% {
                border-color: var(--gold);
                color: #FFFFFF;
                box-shadow:
                    0 0 22px var(--red-bright),
                    0 0 36px rgba(196, 164, 132, 0.5),
                    inset 0 0 24px rgba(232, 213, 183, .22);
            }
        }

        .menu a:hover {
            color: #FFF;
            animation-play-state: paused;
            border-color: var(--gold-bright);
            box-shadow:
                0 0 26px rgba(139, 111, 78, 0.7),
                0 0 42px rgba(196, 164, 132, 0.55),
                inset 0 0 28px rgba(232, 213, 183, 0.25);
        }

        .menu a:active {
            transform: scale(.97);
        }

        .menu a::after {
            content: "";
            position: absolute;
            top: 0;
            left: -75%;
            width: 50%;
            height: 100%;
            background: linear-gradient(100deg,
                    transparent 0%,
                    rgba(255, 255, 255, .25) 50%,
                    transparent 100%);
            transform: skewX(-20deg);
            animation: menuSweep 3.6s ease-in-out infinite;
            pointer-events: none;
        }

        .menu a:nth-child(2)::after {
            animation-delay: 1.2s;
        }

        .menu a:nth-child(3)::after {
            animation-delay: 2.4s;
        }

        @keyframes menuSweep {

            0%,
            55% {
                left: -75%;
            }

            90%,
            100% {
                left: 150%;
            }
        }

        /* ============ AMAN BADGE (between menu & features) ============ */
        .aman-badge {
            margin: 16px auto 8px;
            display: inline-block;
            padding: 8px 18px;
            font-family: 'Press Start 2P', cursive;
            font-size: 9px;
            letter-spacing: 1.5px;
            background: linear-gradient(180deg, var(--gold-bright) 0%, var(--gold) 50%, var(--gold-deep) 100%);
            color: #000;
            border: 2px solid #FFF;
            border-radius: 30px;
            box-shadow:
                0 0 12px var(--gold),
                0 0 24px rgba(196, 164, 132, .5),
                inset 0 1px 0 rgba(255, 255, 255, .5);
            text-shadow: 0 1px 0 rgba(255, 255, 255, .3);
            animation: amanPulse 2s ease-in-out infinite;
        }

        .aman-badge .star {
            color: var(--red-bright);
            font-size: 11px;
            vertical-align: middle
        }

        @keyframes amanPulse {

            0%,
            100% {
                transform: scale(1);
                box-shadow: 0 0 12px var(--gold), 0 0 24px rgba(196, 164, 132, .5), inset 0 1px 0 rgba(255, 255, 255, .5)
            }

            50% {
                transform: scale(1.04);
                box-shadow: 0 0 20px var(--gold), 0 0 36px rgba(196, 164, 132, .7), inset 0 1px 0 rgba(255, 255, 255, .5)
            }
        }

        /* ============ FEATURE GRID ============ */
        .features {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 5px;
            margin: 14px 0 0;
        }

        .feature {
            background: linear-gradient(180deg, rgba(50, 38, 25, 0.85), rgba(0, 0, 0, .85));
            border: 1px solid var(--gold-deep);
            border-radius: 5px;
            padding: 8px 4px 7px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .feature::before {
            content: "";
            position: absolute;
            top: -15px;
            left: 50%;
            width: 30px;
            height: 30px;
            margin-left: -15px;
            background: radial-gradient(circle, rgba(196, 164, 132, 0.35), transparent 70%);
            pointer-events: none;
        }

        .feature-icon {
            font-family: 'Rajdhani', sans-serif;
            font-size: 18px;
            font-weight: 900;
            color: var(--gold);
            text-shadow: 0 0 6px var(--gold), 0 0 12px var(--red-bright);
            line-height: 1;
            margin-bottom: 4px;
        }

        .feature-title {
            font-family: 'Press Start 2P', cursive;
            font-size: 7px;
            color: #FFF;
            letter-spacing: .5px;
            margin-bottom: 3px;
            line-height: 1.3;
        }

        .feature-sub {
            font-family: 'Rajdhani', sans-serif;
            font-size: 10px;
            font-weight: 700;
            color: var(--gold-soft);
            letter-spacing: .3px;
            line-height: 1.2;
        }

        /* ============ PAYMENT STRIP ============ */
        .payments {
            margin-top: 12px;
            padding: 10px 8px;
            border: 1px solid var(--gold-deep);
            border-radius: 6px;
            background: linear-gradient(180deg, rgba(0, 0, 0, .6), rgba(30, 22, 15, .7));
        }

        .pay-title {
            font-family: 'Press Start 2P', cursive;
            font-size: 7px;
            color: var(--gold);
            letter-spacing: 1.5px;
            margin-bottom: 8px;
            text-align: center;
            text-shadow: 0 0 6px var(--gold-deep);
        }

        .pay-list {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 4px;
        }

        .pay {
            font-family: 'Rajdhani', sans-serif;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .3px;
            padding: 4px 8px;
            border-radius: 3px;
